<?xml version="1.0" encoding="utf-8"?>
<!--
  Installateur Snowhush pour Windows (WiX 3).
  - Installation par utilisateur : pas de droits administrateur, pas d'UAC.
  - Dossier : %LOCALAPPDATA%\Programs\Snowhush
  - Raccourci menu Démarrer, lancement à l'ouverture de session, démarrage
    automatique en fin d'installation.
  - Mises à jour : un MSI plus récent remplace l'ancien (MajorUpgrade).
  - L'application en cours est fermée proprement avant mise à jour ou
    désinstallation.
  Variables passées par build-msi.ps1 : Version, ExePath, IconPath, LicensePath.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product Id="*"
           Name="Snowhush"
           Language="1036"
           Codepage="1252"
           Version="$(var.Version)"
           Manufacturer="Snowhush pour Windows"
           UpgradeCode="034F6225-5A98-4854-85FF-7AF09C8EB028">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             InstallPrivileges="limited"
             Platform="x64"
             Languages="1036"
             SummaryCodepage="1252"
             Description="Snowhush - neige sur le bureau"
             Comments="Neige légère, accélérée GPU, transparente aux clics." />

    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de Snowhush est déjà installée."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="SnowhushIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SnowhushIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mbezruchko/Snowhush" />
    <Property Id="ALLUSERS" Secure="yes" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Secure="yes" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="Snowhush" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <!-- GUID fixe : fichier + clé de registre (exigé pour une install par utilisateur). -->
      <Component Id="AppExe" Guid="B723B3A2-12C9-4344-8CD7-F68AE3152EAD">
        <File Id="SnowhushExe" Name="snowhush.exe" Source="$(var.ExePath)" />
        <RegistryValue Root="HKCU" Key="Software\SnowhushWin" Name="InstallDir"
                       Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>

      <Component Id="Autostart" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="SnowhushWin" Type="string" Value="&quot;[INSTALLFOLDER]snowhush.exe&quot;" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="SnowhushShortcut"
                  Name="Snowhush"
                  Description="Neige sur le bureau"
                  Target="[INSTALLFOLDER]snowhush.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="SnowhushIcon" />
        <RegistryValue Root="HKCU" Key="Software\SnowhushWin" Name="Shortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="Snowhush" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="Autostart" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Ferme l'instance en cours avant de remplacer ou supprimer l'exe. -->
    <util:CloseApplication Id="CloseSnowhush" Target="snowhush.exe"
                           CloseMessage="yes" RebootPrompt="no" TerminateProcess="0" />

    <!-- Lance la neige à la fin de l'installation (pas lors d'une désinstallation). -->
    <CustomAction Id="LaunchSnowhush" FileKey="SnowhushExe" ExeCommand="" Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchSnowhush" After="InstallFinalize">NOT REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <!-- Interface : bienvenue + licence, puis installation. -->
    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicensePath)" />
  </Product>
</Wix>
